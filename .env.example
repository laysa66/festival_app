# ================================
# Festival App - Environment Variables
# ================================
# Copy this file to .env and fill in the values

# ================================
# Database Configuration
# ================================
POSTGRES_USER=festivalapp
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=festivalappdb

# ================================
# Backend Configuration
# ================================
# Database URL (for Prisma)
DATABASE_URL=postgresql://festivalapp:your-secure-password-here@db:5432/festivalappdb

# JWT Secret (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your-super-secure-jwt-secret-minimum-32-characters-long

# App Settings
PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# CORS (your frontend URL)
CORS_ORIGIN=http://162.38.111.33

# ================================
# Production Notes
# ================================
# 1. Never commit the .env file to git
# 2. Use strong passwords in production
# 3. Generate a unique JWT_SECRET for production
# 4. Update CORS_ORIGIN to match your domain
